<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>autowire-migrate</ToolCommandName>
    <PackageId>Swevo.AutoWire.Migrator</PackageId>
    <Version>1.0.0</Version>
    <Authors>Justin Bannister</Authors>
    <Description>dotnet tool that migrates Scrutor, Autofac and plain Microsoft DI registrations to AutoWire attributes, with confidence-rated reports, CI gating and registration manifest diffing.</Description>
    <PackageTags>autowire;migration;scrutor;autofac;dependency-injection;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Swevo/AutoWire</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Swevo/AutoWire.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
