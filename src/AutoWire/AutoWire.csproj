<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- NU5017: symbols package empty (no PDB — expected for source generators)  -->
    <!-- NU5128: no lib/netstandard2.0/ assembly — expected since DLL is in analyzers/ -->
    <NoWarn>$(NoWarn);NU5017;NU5128</NoWarn>

    <PackageId>AutoWire</PackageId>
    <Title>AutoWire - Compile-time DI auto-registration</Title>
    <Product>AutoWire</Product>
    <Company>Swevo</Company>
    <Version>1.26.1</Version>
    <Authors>Justin Bannister</Authors>
    <Copyright>Copyright (c) 2025 Justin Bannister</Copyright>
    <Description>Compile-time dependency injection auto-registration for .NET using Roslyn source generators. Add [Scoped], [Singleton], or [Transient] to your classes — AutoWire generates IServiceCollection registration code at build time. Zero runtime overhead, no reflection, no startup cost. Supports keyed services (.NET 8+) and works with ASP.NET Core, Worker Services, MAUI, and any Microsoft.Extensions.DependencyInjection project.</Description>
    <PackageTags>dependency-injection;source-generator;source-generators;di;iservicecollection;auto-register;roslyn;dotnet;aspnetcore;scoped;singleton;transient;compile-time;zero-reflection;native-aot;aot;keyed-services;worker-service;maui;scrutor-alternative;autofac-alternative;microsoft-extensions-dependencyinjection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Swevo/AutoWire</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Swevo/AutoWire</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>false</IncludeSymbols>
    <EnablePackageValidation>true</EnablePackageValidation>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageReleaseNotes>1.26.1: Skip inaccessible base-type interfaces when auto-registering (fixes MAUI pages). 1.26.0: Open-generic decorators (AW027), open-generic convention scanning, Swevo.AutoWire.Migrator tool. Full history: https://github.com/Swevo/AutoWire/blob/master/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.*" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.*" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Reference the code fixes project so its output DLL is available for packing -->
    <ProjectReference Include="..\AutoWire.CodeFixes\AutoWire.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- Place the generator DLL in analyzers/dotnet/cs/ so NuGet loads it as a source generator -->
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <!-- Pack the code fixes DLL alongside the generator -->
    <None Include="..\AutoWire.CodeFixes\bin\$(Configuration)\netstandard2.0\AutoWire.CodeFixes.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <!-- MSBuild props file that adds the analyzer reference — required for NuGet to wire it up -->
    <None Include="build\AutoWire.props" Pack="true" PackagePath="build\" />
  </ItemGroup>
</Project>
