<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- NU5017: symbols package empty (no PDB — expected for source generators)  -->
    <!-- NU5128: no lib/netstandard2.0/ assembly — expected since DLL is in analyzers/ -->
    <NoWarn>$(NoWarn);NU5017;NU5128</NoWarn>

    <PackageId>AutoWire</PackageId>
    <Version>1.27.0</Version>
    <Title>AutoWire – compile-time DI registration (Native AOT-safe Scrutor alternative)</Title>
    <Authors>Justin Bannister</Authors>
    <Copyright>Copyright (c) 2025 Justin Bannister</Copyright>
    <Description>Compile-time dependency injection registration for .NET: the Native AOT-safe alternative to Scrutor assembly scanning. Put [Scoped], [Singleton] or [Transient] on a class and AutoWire generates the IServiceCollection code at build time, with no reflection and no startup cost. It also checks your DI graph while you type: captive dependencies, circular dependencies, missing registrations and wrong service types become IDE squiggles with one-click fixes. Includes a migrator for existing Scrutor, Autofac and manual registrations. Requires the .NET 8 SDK (Visual Studio 2022 17.8) or later; works with any Microsoft.Extensions.DependencyInjection app.</Description>
    <PackageTags>dependency-injection;di;source-generator;roslyn;iservicecollection;auto-registration;scrutor;scrutor-alternative;autofac-alternative;injectio-alternative;native-aot;aot;trimming;compile-time;zero-reflection;keyed-services;decorator;aspnetcore;worker-service;maui;analyzers</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Swevo/AutoWire</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Swevo/AutoWire</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>false</IncludeSymbols>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageReleaseNotes>1.27.0: Pinned Roslyn dependencies to 4.8.0 so the generator loads on every .NET 8+ SDK and Visual Studio 2022 17.8+ (previously it could silently fail to load on older toolchains). Generated AutoWire attributes and DuplicateStrategy are now internal, removing CS0436 type-conflict warnings in multi-project solutions. Smaller package (new 4 KB icon). Full history: https://github.com/Swevo/AutoWire/blob/master/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.*" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Reference the code fixes project so its output DLL is available for packing -->
    <ProjectReference Include="..\AutoWire.CodeFixes\AutoWire.CodeFixes.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <!-- Place the generator DLL in analyzers/dotnet/cs/ so NuGet loads it as a source generator -->
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <!-- Pack the code fixes DLL alongside the generator -->
    <None Include="..\AutoWire.CodeFixes\bin\$(Configuration)\netstandard2.0\AutoWire.CodeFixes.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <!-- MSBuild props file that adds the analyzer reference — required for NuGet to wire it up -->
    <None Include="build\AutoWire.props" Pack="true" PackagePath="build\" />
  </ItemGroup>
</Project>
