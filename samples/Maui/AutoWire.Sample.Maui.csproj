<Project Sdk="Microsoft.NET.Sdk">
  <!-- Requires the MAUI workload: dotnet workload install maui -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>AutoWire Sample</ApplicationTitle>
    <ApplicationId>com.swevo.autowire.sample</ApplicationId>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.*" />
    <!-- In your own app: <PackageReference Include="AutoWire" Version="1.27.0" /> -->
    <!-- The samples reference the generator project directly so they always match the current source. -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoWire\AutoWire.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
